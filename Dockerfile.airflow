# Airflow image = our Spark image + Microsoft ODBC driver + dbt (own venv) + Airflow (own venv)
FROM nyc-taxi-full-data-engineering-spark:latest

# 1) Microsoft ODBC Driver 18: dbt needs it to talk to SQL Server
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl gnupg2 ca-certificates unixodbc-dev \
    && curl -sSL https://packages.microsoft.com/keys/microsoft.asc | gpg --dearmor -o /usr/share/keyrings/microsoft-prod.gpg \
    && echo "deb [arch=amd64 signed-by=/usr/share/keyrings/microsoft-prod.gpg] https://packages.microsoft.com/debian/12/prod bookworm main" > /etc/apt/sources.list.d/mssql-release.list \
    && apt-get update \
    && ACCEPT_EULA=Y apt-get install -y msodbcsql18 \
    && rm -rf /var/lib/apt/lists/*

# 2) dbt in its own virtual environment (keeps its packages away from Spark and Airflow)
RUN python -m venv /opt/dbt-venv \
    && /opt/dbt-venv/bin/pip install --no-cache-dir dbt-sqlserver pyodbc

# 3) Airflow in its own virtual environment, installed with the official constraints file
ARG AIRFLOW_VERSION=2.11.2
RUN python -m venv /opt/airflow-venv \
    && /opt/airflow-venv/bin/pip install --no-cache-dir "apache-airflow==${AIRFLOW_VERSION}" \
       --constraint "https://raw.githubusercontent.com/apache/airflow/constraints-${AIRFLOW_VERSION}/constraints-3.11.txt"

ENV AIRFLOW_HOME=/opt/airflow
WORKDIR /app