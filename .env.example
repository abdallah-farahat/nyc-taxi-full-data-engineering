# Local or Azure switch. Later we change this and the paths below for Azure.
STORAGE_MODE=local

# Folders on your Windows PC that are mounted into the container
RAW_DATA_HOST_PATH=F:/datasets/tlc_raw
LAKEHOUSE_HOST_PATH=./data/lakehouse

# Paths INSIDE the container. Our code reads only these.
RAW_DATA_PATH=/data/raw
LAKEHOUSE_PATH=/data/lakehouse

# Memory for Spark (Docker has 20 GB in total)
SPARK_DRIVER_MEMORY=10g

SQLSERVER_HOST=host.docker.internal
SQLSERVER_PORT=1433
SQLSERVER_DB=nyc_taxi_dw
SQLSERVER_USER=datapill_user
SQLSERVER_PASSWORD=change_me

# Which month is served by the API and streamed through Kafka
STREAM_MONTH=2026-09
KAFKA_BOOTSTRAP=kafka:9092
API_URL=http://api:8000